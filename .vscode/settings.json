{
    // ======================================================================
    // 1. Python Interpreter & Environment
    // ======================================================================
    "python.terminal.activateEnvironment": true,

    // ======================================================================
    // 2. Language Server: Pylance (Pyright) für Code Completion
    // ======================================================================
    // Pylance/Pyright für Completion und Navigation verwenden
    "python.languageServer": "Pylance",

    // WICHTIG: Type-Checking von Pylance/Pyright ausschalten
    "python.analysis.typeCheckingMode": "off",

    // Pylance Einstellungen für bessere Completion
    "python.analysis.autoImportCompletions": true,
    "python.analysis.completeFunctionParens": true,
    "python.analysis.inlayHints.variableTypes": false,
    "python.analysis.inlayHints.functionReturnTypes": false,

    // ======================================================================
    // 3. Mypy: NUR für Type-Checking beim Speichern
    // ======================================================================
    // Mypy Extension von Microsoft verwenden
    "mypy-type-checker.importStrategy": "fromEnvironment",

    // Mypy nur bei Workspace-weiten Überprüfungen ausführen
    "mypy-type-checker.reportingScope": "workspace",

    // Daemon deaktivieren für zuverlässigere Checks
    "mypy-type-checker.preferDaemon": false,

    // Benachrichtigungen nur bei Fehlern
    "mypy-type-checker.showNotifications": "onError",

    // ======================================================================
    // 4. Formatting & Linting mit Ruff (bleibt unverändert)
    // ======================================================================
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    "ruff.importStrategy": "fromEnvironment",

    // ======================================================================
    // 5. Test Integration (bleibt unverändert)
    // ======================================================================
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": ["tests"],
    "python.testing.unittestEnabled": false,
    "python.testing.autoTestDiscoverOnSaveEnabled": true
}

